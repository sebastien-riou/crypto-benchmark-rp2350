#!/bin/bash



#CC=`which riscv-none-elf-gcc`
#CXX=`which riscv-none-elf-g++`
#EXTERNAL_TOOLCHAIN="-DCMAKE_C_COMPILER:FILEPATH=$CC -DCMAKE_CXX_COMPILER:FILEPATH=$CXX"
EXTERNAL_TOOLCHAIN=""

set -ex

CPU=${1:-rv32imc}
PRESET=${2:-Release}

case $CPU in

  rv32imc)
    PICO_PLATFORM=rp2350-riscv
    ;;

  cortex-m33)
    PICO_PLATFORM=rp2350-arm-s
    ;;

  *)
    echo "ERROR: CPU must be 'rv32imc' or 'cortex-m33'"
    exit -1
    ;;

esac



ROOT=`pwd`

rm -rf build
cmake -DCMAKE_BUILD_TYPE:STRING=$PRESET -DPICO_PLATFORM=$PICO_PLATFORM -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE $EXTERNAL_TOOLCHAIN -DPython3_EXECUTABLE:STRING=/bin/python3 --no-warn-unused-cli -S $ROOT -B $ROOT/build -G Ninja
cmake --build $ROOT/build --config $PRESET --target all $OPT --

