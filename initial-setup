#!/bin/bash

set -ex

CRYPTO_BENCHMARK_TAG=v0.0.14
WOLFSSL_TAG=v0.0.14
PICOSDK_TAG=2.2.0
PICOTOOL_TAG=v2.2.0-3

PICOTOOLS_VERSION=2.2.0-3
PICOTOOLS_TARGZ=picotool-2.2.0-a4-x86_64-lin.tar.gz
wget https://github.com/raspberrypi/pico-sdk-tools/releases/download/v$PICOTOOLS_VERSION/$PICOTOOLS_TARGZ
tar -xvzf $PICOTOOLS_TARGZ
rm $PICOTOOLS_TARGZ

ARM_PATH=$(./get_arm_toolchain | tail -n 1)
RV_PATH=$(./get_riscv_toolchain | tail -n 1)

export PATH=$ARM_PATH:$RV_PATH:$PATH

cd ..
if [[ ! -z $CRYPTO_BENCHMARK_USE_GIT_SSH ]]; then
    CRYPTO_BENCHMARK_URL=git@github.com:sebastien-riou/crypto-benchmark.git
    WOLFSSL_URL=git@github.com:sebastien-riou/wolfssl.git
else
    CRYPTO_BENCHMARK_URL=https://github.com/sebastien-riou/crypto-benchmark.git
    WOLFSSL_URL=https://github.com/sebastien-riou/wolfssl.git
fi

git clone --depth=1 $CRYPTO_BENCHMARK_URL --branch $CRYPTO_BENCHMARK_TAG --single-branch
git clone --depth=1 $WOLFSSL_URL --branch $WOLFSSL_TAG --single-branch
git clone --depth=1 https://github.com/raspberrypi/pico-sdk.git --branch $PICOSDK_TAG --single-branch --recurse-submodules

