#!/bin/bash

set -ex

XPACK_TRIPLE=riscv-none-elf
XPACK_VERSION=15.2.0-1
XPACK_DST_ROOT=~/.local/xPacks

XPACK_GCC=$XPACK_TRIPLE-gcc
XPACK_DIR=xpack-$XPACK_GCC-$XPACK_VERSION
XPACK_TARGZ=$XPACK_DIR-linux-x64.tar.gz

XPACK_DST=$XPACK_DST_ROOT/$XPACK_GCC

ROOT=`pwd`
wget https://github.com/xpack-dev-tools/$XPACK_GCC-xpack/releases/download/v$XPACK_VERSION/$XPACK

mkdir -p $XPACK_DST
cd $XPACK_DST

tar xvf $ROOT/$XPACK_TARGZ
chmod -R -w $XPACK_DIR

rm $ROOT/$XPACK_TARGZ

ls $XPACK_DST
echo $XPACK_DST